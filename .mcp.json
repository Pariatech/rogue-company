{
  "mcpServers": {
    "rogue-company": {
      "type": "http",
      "url": "http://127.0.0.1:7777/mcp",
      "headers": {
        "Authorization": "Bearer ${LISP_GAME_MCP_TOKEN}"
      }
    },
    "game-console": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "bridge/server.ts"
      ],
      "env": {
        "LISP_GAME_MCP_TOKEN": "${LISP_GAME_MCP_TOKEN}"
      }
    }
  }
}
