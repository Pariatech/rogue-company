(asdf:defsystem #:rogue-company
  :description "Jeu en Common Lisp (SBCL, raylib) modifiable à chaud par MCP."
  :author "Gabriel Pariat"
  :license "MIT"
  :depends-on (#:game-kit #:cl-raylib #:yason #:sb-md5)
  :serial t
  :pathname "src"
  :in-order-to ((asdf:test-op (asdf:test-op #:rogue-company/tests)))
  :components ((:file "package")
               (:file "ticks")
               (:file "stats")
               (:file "equipment")
               (:file "items")
               (:file "formation")
               (:file "soldiers")
               (:file "regiment")
               (:file "spatial-grid")
               (:file "terrain")
               (:file "collision")
               (:file "main-menu")
               (:file "battle")
               (:file "deaths")
               (:file "wounds")
               (:file "flanks")
               (:file "combat")
               (:file "shooting")
               (:file "stances")
               (:file "morale")
               (:file "charge")
               (:file "penetration")
               (:file "victory")
               (:file "demo-battle")
               (:file "camera")
               (:file "sprites")
               (:file "terrain-view")
               (:file "vegetation-view")
               (:file "battle-view")
               (:file "soldier-parts")
               (:file "blood-view")
               (:file "tally-view")
               (:file "command")
               (:file "ai")
               (:file "ai-general")
               (:file "ai-tasks")
               (:file "ai-captain")
               (:file "ai-bench")
               (:file "replay")
               (:file "ai-view")
               (:file "battle-scene")
               (:file "game")))

(asdf:defsystem #:rogue-company/tests
  :depends-on (#:rogue-company #:fiveam)
  :pathname "tests"
  :serial t
  :components ((:file "package")
               (:file "formation-tests")
               (:file "battle-tests")
               (:file "collision-tests")
               (:file "terrain-tests")
               (:file "combat-tests")
               (:file "flank-tests")
               (:file "stance-tests")
               (:file "equipment-tests")
               (:file "charge-tests")
               (:file "command-tests")
               (:file "ai-tests")
               (:file "ai-plan-tests")
               (:file "victory-tests")
               (:file "replay-tests"))
  :perform (asdf:test-op (o c)
             (when (member nil (mapcar (lambda (suite)
                                       (uiop:symbol-call :fiveam :run!
                                                         (uiop:find-symbol* suite :rogue-company/tests)))
                                     '(:formation :battle :collision :terrain :combat :flanks :stances :equipment :charge :command :ai :ai-plan :victory :replay)))
               (error "Des tests ont échoué."))))
